local AllIDs = {}
local foundAnything = ""
local actualHour = os.date("!*t").hour
local S_T = game:GetService("TeleportService")
local S_H = game:GetService("HttpService")
local FileName = "server-hop-temp.json"

pcall(function()
    AllIDs = S_H:JSONDecode(readfile(FileName))
end)

if type(AllIDs) ~= "table" then
    AllIDs = {}
end

local function CleanIDs()
    local Now = os.time()
    local Cleaned = {actualHour}

    for _, Entry in ipairs(AllIDs) do
        if type(Entry) == "table"
            and Entry.id
            and Entry.time
            and Now - Entry.time < 600 then
            table.insert(Cleaned, Entry)
        end
    end

    AllIDs = Cleaned

    pcall(function()
        writefile(FileName, S_H:JSONEncode(AllIDs))
    end)
end

CleanIDs()

local function TPReturner(placeId)
    CleanIDs()

    local URL = "https://games.roblox.com/v1/games/"
        .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"

    if foundAnything ~= "" then
        URL = URL .. "&cursor=" .. foundAnything
    end

    local Success, Site = pcall(function()
        return S_H:JSONDecode(game:HttpGet(URL))
    end)

    if not Success or type(Site) ~= "table" or type(Site.data) ~= "table" then
        foundAnything = ""
        return
    end

    foundAnything = Site.nextPageCursor or ""

    for _, v in ipairs(Site.data) do
        CleanIDs()

        local ID = tostring(v.id)
        local Possible = tonumber(v.maxPlayers) > tonumber(v.playing)

        if Possible then
            for _, Existing in ipairs(AllIDs) do
                if type(Existing) == "table" and tostring(Existing.id) == ID then
                    Possible = false
                    break
                end
            end
        end

        if Possible then
            table.insert(AllIDs, {
                id = ID,
                time = os.time()
            })

            pcall(function()
                writefile(FileName, S_H:JSONEncode(AllIDs))
            end)

            S_T:TeleportToPlaceInstance(
                placeId,
                ID,
                game.Players.LocalPlayer
            )

            task.wait(4)
        end
    end
end

local module = {}

function module:Teleport(placeId)
    while task.wait() do
        pcall(function()
            TPReturner(placeId)

            if foundAnything ~= "" then
                TPReturner(placeId)
            end
        end)
    end
end

return module
