pcall(function()
	local playerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
	local MainGui = playerGui:WaitForChild("MainGui")

	for _, v in ipairs(MainGui:GetChildren()) do
		if v:IsA("LocalScript") and v ~= script then
			v.Disabled = true
			break
		end
	end
end)

game.Players.LocalPlayer:Kick("Script is outdated. Wait for the owner to update (Less than 1 hour depending if they changed the anti-cheat)")
