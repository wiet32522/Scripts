        return
    end

    local existingMoneyBoxes = bankModel:FindFirstChild("MoneyBoxes", true)

    if not bankPrompt then
        if existingMoneyBoxes then
            log("Bank prompt not found, but MoneyBoxes exist; continuing with MoneyBoxes farm")
        else
