    for _, model in ipairs(models) do
        for _, object in ipairs(model:GetDescendants()) do
            if object:IsA("UnionOperation") and object.Name == "Glass" then
                local prompt = findPromptUnder(object)
                if prompt and not seenGlass[prompt] then
                    seenGlass[prompt] = true
                    pcall(function()
                        prompt.HoldDuration = 0
                        prompt.RequiresLineOfSight = false
                    end)
                    table.insert(glassPrompts, prompt)
                end
            elseif object:IsA("MeshPart") and object.Name == "Jewelry" then
                local prompt = findPromptUnder(object)
                if prompt and not seenJewelry[prompt] then
                    seenJewelry[prompt] = true
                    pcall(function()
                        prompt.HoldDuration = 0
                        prompt.RequiresLineOfSight = false
                    end)
                    table.insert(jewelryPrompts, prompt)
                end
            end
        end
    end

    log("Glass prompts: " .. #glassPrompts .. " | Jewelry prompts: " .. #jewelryPrompts)
    return glassPrompts, jewelryPrompts
end

local function firePromptList(prompts, label)
    for _, prompt in ipairs(prompts) do
        if not running then
            return
        end

        if prompt and prompt.Parent and prompt.Enabled then
            firePrompt(prompt, label)
        end
    end
end

local function breakableGlassFarm(root)
    log("========== BREAKABLE GLASS FARM START ==========")

    if not teleport(root, glassFarmPositions[1], "firstJewelryPosition") then
        return
    end

    local glassPrompts, jewelryPrompts = {}, {}
    local attempts = {}
    local lastAttempt = {}
    local index, lastRefresh, nextPositionAt = 0, 0, os.clock()
    local visitedThisCycle = 0

    while running and root and root.Parent do
        if os.clock() - lastRefresh >= 0.75 then
            local models, status = findBreakableGlassModels()
            glassPrompts, jewelryPrompts = collectBreakablePrompts(models)
            log(status .. " | Glass prompts: " .. #glassPrompts .. " | Jewelry prompts: " .. #jewelryPrompts)
            lastRefresh = os.clock()
        end

        local totalPrompts = #glassPrompts + #jewelryPrompts
        local allFinished = totalPrompts > 0

        for _, pair in ipairs({{glassPrompts, "Glass"}, {jewelryPrompts, "Jewelry"}}) do
            for _, prompt in ipairs(pair[1]) do
                if prompt and prompt.Parent and prompt.Enabled then
                    local count = attempts[prompt] or 0
                    if count < 3 then
                        allFinished = false
                    end

                    if os.clock() - (lastAttempt[prompt] or 0) >= 0.35 then
                        if firePrompt(prompt, pair[2]) then
                            attempts[prompt] = count + 1
                            lastAttempt[prompt] = os.clock()
                        else
                            lastAttempt[prompt] = os.clock()
                        end
                    end
                end
            end
        end

        if os.clock() >= nextPositionAt then
            index += 1
            if index > #glassFarmPositions then
                index = 1
                visitedThisCycle += 1
            end
            if not teleport(root, glassFarmPositions[index], "glassFarmPosition" .. index) then
                break
            end
            nextPositionAt = os.clock() + 0.5

            if visitedThisCycle >= 1 and allFinished then
                log("Jewelry/glass prompts have been attempted; moving to Museum")
                break
            end
        end
        task.wait(0.05)
    end

    log("Jewelry farm ended")
end

local function hopToMatchingServer()
    local serverList = ReplicatedStorage:FindFirstChild("Servers_List")
    local events = ReplicatedStorage:FindFirstChild("Events")
    local introLoad = events and events:FindFirstChild("IntroLoad")

    if not serverList or not introLoad then
        return false
    end

    local currentServer
    local currentType

    for _, server in ipairs(serverList:GetChildren()) do
        local yourServer = server:FindFirstChild("YourServer")

        if yourServer and yourServer:IsA("BoolValue") and yourServer.Value == true then
            currentServer = server

            local serverType = server:FindFirstChild("ServerType")
            if serverType and serverType:IsA("StringValue") then
                currentType = serverType.Value
            end

            break
        end
    end

    if not currentServer or currentType == nil then
        return false
    end

    for _, server in ipairs(serverList:GetChildren()) do
        if not running then
            return false
        end

        if server ~= currentServer then
            local serverType = server:FindFirstChild("ServerType")

            if serverType and serverType:IsA("StringValue") and serverType.Value == currentType then
                pcall(function()
                    introLoad:FireServer("RequestJoinServer", server)
                end)

                local deadline = os.clock() + 0.1
                repeat
                    task.wait(0.1)

                    for _, checkServer in ipairs(serverList:GetChildren()) do
                        local yourServer = checkServer:FindFirstChild("YourServer")
                        if yourServer and yourServer:IsA("BoolValue") and yourServer.Value == true
                            and checkServer ~= currentServer then
                            return true
                        end
                    end
                until os.clock() >= deadline or not running
            end
        end
    end

    return false
end

local function museumFarm(root)
    log("========== MUSEUM FARM START ==========")
    local index = 0
    local museum, artFolder
    local prompts = {}
    local attempts = {}
    local lastAttempt = {}
    local lastRefresh = 0
    local nextPositionAt = os.clock()
    local visitedThisCycle = 0

    while running and root and root.Parent do
        if os.clock() - lastRefresh >= 0.75 then
            museum = workspace:FindFirstChild("MUSEUM", true)
            artFolder = museum and museum:FindFirstChild("Art", true)
            prompts = {}
            local seenPrompts = {}
            local artModelCount = 0

            if artFolder then
                for _, object in ipairs(artFolder:GetDescendants()) do
                    if object:IsA("Model") and object.Name == "Art" then
                        artModelCount += 1
                        local mainPart = object:FindFirstChild("MainPart", true)
                        local prompt = findPromptUnder(mainPart) or findPromptUnder(object)
                        if prompt and not seenPrompts[prompt] then
                            seenPrompts[prompt] = true
                            pcall(function()
                                prompt.HoldDuration = 0
                                prompt.RequiresLineOfSight = false
                            end)
                            table.insert(prompts, prompt)
                        end
                    end
                end
            end

            log("Museum refresh: found " .. artModelCount .. " Art models and " .. #prompts .. " prompts")
            lastRefresh = os.clock()

            if artFolder and artModelCount == 0 then
                log("Art folder has no Art models; hopping to another server")
                if not hopToMatchingServer() then
                    pcall(function()
                        TeleportService:Teleport(game.PlaceId, player)
                    end)
                end
                return
            end
        end

        local allFinished = #prompts > 0
        for _, prompt in ipairs(prompts) do
            if prompt and prompt.Parent and prompt.Enabled then
                local count = attempts[prompt] or 0
                if count < 3 then
                    allFinished = false
                end

                if os.clock() - (lastAttempt[prompt] or 0) >= 0.35 then
                    if firePrompt(prompt, "Museum Art") then
                        attempts[prompt] = count + 1
                        lastAttempt[prompt] = os.clock()
                    else
                        lastAttempt[prompt] = os.clock()
                    end
                end
            end
        end

        if os.clock() >= nextPositionAt then
            index += 1
            if index > #museumPositions then
                index = 1
                visitedThisCycle += 1
            end
            if not teleport(root, museumPositions[index], "museumPosition" .. index) then
                break
            end
            nextPositionAt = os.clock() + 0.5

            if visitedThisCycle >= 1 and allFinished then
                log("Museum prompts have been attempted after visiting every position; attempting to rejoin")
                break
            end
        end

        task.wait(0.05)
    end

    if running then
        task.wait(1)
        if not hopToMatchingServer() then
            pcall(function()
                TeleportService:Teleport(game.PlaceId, player)
            end)
        end
    end
end

local function fallDown(root)
    if not root or not root.Parent then
        log("ERROR: Cannot fall; HumanoidRootPart missing")
        return false
    end

    workspace.Gravity = 196.2
    log("Gravity restored to 196.2")

    log("Teleporting 350 studs down")
    root.CFrame = root.CFrame - Vector3.new(0, 350, 0)

    return true
end

local function waitForNewCharacter(oldCharacter, timeoutSeconds)
    log("Waiting for respawn...")

    local newCharacter

    local connection = player.CharacterAdded:Connect(function(character)
        if character ~= oldCharacter then
            newCharacter = character
        end
    end)

    local current = player.Character

    if current and current ~= oldCharacter then
        newCharacter = current
    end

    local deadline = os.clock() + timeoutSeconds

    while running and not newCharacter and os.clock() < deadline do
        current = player.Character

        if current and current ~= oldCharacter then
            newCharacter = current
            break
        end

        task.wait(0.1)
    end

    connection:Disconnect()

    if not newCharacter then
        log("ERROR: Respawn timed out")
        return nil, nil
    end

    local root = newCharacter:WaitForChild("HumanoidRootPart", 10)
    local humanoid = newCharacter:WaitForChild("Humanoid", 10)

    if not root or not humanoid then
        log("ERROR: Respawn character did not load")
        return nil, nil
    end

    local camera = workspace.CurrentCamera

    if camera then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = humanoid
    end

    log("Respawn complete")

    return newCharacter, root
end

local function Start()
    log("Script started")

    local character, root = getCharacter()

    if isEscaped() then
        log("Already Escaped; skipping fall and starting bank farm")
        workspace.Gravity = 196.2
        bankFarm(root)
        if running and root.Parent then
            breakableGlassFarm(root)
            if running and root.Parent then museumFarm(root) end
        end
        return
    end

    log("Not Escaped; disabling gravity and starting movement loop")
    workspace.Gravity = 0

    if not teleport(root, pos1, "pos1") then
        return
    end

    local nextResetAt = os.clock() + 120

    while running and root and root.Parent do
        if isEscaped() then
            log("Team changed to Escaped")
            break
        end

        if os.clock() >= nextResetAt then
            log("Two minutes elapsed while waiting for Escaped; falling to trigger respawn")
            local oldCharacter = player.Character
            local oldRoot = oldCharacter and oldCharacter:FindFirstChild("HumanoidRootPart")

            workspace.Gravity = 196.2
            if oldRoot then
                oldRoot.CFrame = oldRoot.CFrame - Vector3.new(0, 350, 0)
            end

            local newCharacter, newRoot = waitForNewCharacter(oldCharacter, 30)
            if not newCharacter or not newRoot then
                log("Fall respawn failed; stopping escape wait")
                return
            end

            task.wait(4)
            if not running or not newRoot.Parent then
                return
            end

            character, root = newCharacter, newRoot
            workspace.Gravity = 0
            if not teleport(root, pos1, "pos1 after fall respawn") then
                return
            end
            nextResetAt = os.clock() + 120
        end

        if not moveTo(root, pos2, 18, "pos2") then
            break
        end

        if isEscaped() then
            log("Team changed to Escaped")
            break
        end

        if not moveTo(root, pos1, 18, "pos1") then
            break
        end

        task.wait()
    end

    if not running then
        return
    end

    if not isEscaped() then
        log("Escaped not detected; bank farm skipped")
        return
    end

    log("Escaped detected; restoring gravity and falling 350 studs")

    if not fallDown(root) then
        return
    end

    local newCharacter, newRoot = waitForNewCharacter(character, 30)

    if not newCharacter or not newRoot then
        log("Respawn failed; bank farm skipped")
        return
    end

    log("Respawned; waiting 2.5 seconds")
    task.wait(2.5)

    if not running or not newRoot.Parent then
        log("Character unavailable; bank farm cancelled")
        return
    end

    log("Searching for BANK after respawn")

    local bankModel
    local started = os.clock()

    repeat
        bankModel = workspace:FindFirstChild("BANK")

        if not bankModel then
            task.wait(0.25)
        end
    until bankModel or os.clock() - started >= 15 or not running

    if not bankModel then
        log("BANK not found after waiting 15 seconds")
        return
    end

    log("BANK found; starting bank farm")
    bankFarm(newRoot)

    if running and newRoot.Parent then
        breakableGlassFarm(newRoot)
        if running and newRoot.Parent then museumFarm(newRoot) end
    end
end

local originalGravity = workspace.Gravity
local autoFarmStarting = false

local function StartAutoFarm()
    if autoFarmStarting then
        return
    end

    autoFarmStarting = true
    running = true

    task.spawn(function()
        task.wait(2)
        if not AutoFarmPreference then
            autoFarmStarting = false
            return
        end

        local success, err = xpcall(Start, debug.traceback)
        if not success then
            log("SCRIPT ERROR:\n" .. tostring(err))
        end

        autoFarmStarting = false
        if AutoFarmPreference and player.Parent then
            task.wait(2)
            if AutoFarmPreference then
                StartAutoFarm()
            end
        end
    end)
end

settingsBox:AddToggle("AutoFarmEnabled", {
