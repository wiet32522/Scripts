    if not running or not root or not root.Parent then
        log("Cannot move to " .. label .. "; stopped or root missing")
        return false
    end

    local distance = (root.Position - position).Magnitude

    if distance < 0.1 then
        return true
    end

    local duration = math.max(distance / (speed or 18), 0.05)

    log("Tweening to " .. label
        .. " | Distance: " .. math.floor(distance)
