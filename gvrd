local function GetUKTime()
    local now = os.time()
    local utc = os.date("!*t", now)
    local year, month, day, hour = utc.year, utc.month, utc.day, utc.hour

    local function daysInMonth(y, m)
        if m == 2 then
            local leap = (y % 4 == 0 and y % 100 ~= 0) or (y % 400 == 0)
            return leap and 29 or 28
        end
        if m == 4 or m == 6 or m == 9 or m == 11 then return 30 end
        return 31
    end

    local function lastSundayOfMonth(m)
        local lastDay = daysInMonth(year, m)
        local daysBack = (utc.wday - 1 + (lastDay - day)) % 7
        return lastDay - daysBack
    end

    local marchSunday = lastSundayOfMonth(3)
    local octoberSunday = lastSundayOfMonth(10)
    local isBST = month > 3 and month < 10
        or (month == 3 and (day > marchSunday or (day == marchSunday and hour >= 1)))
        or (month == 10 and (day < octoberSunday or (day == octoberSunday and hour < 1)))

    local uk = os.date("!*t", now + (isBST and 3600 or 0))
    return string.format("%04d-%02d-%02d %02d:%02d:%02d %s",
        uk.year, uk.month, uk.day, uk.hour, uk.min, uk.sec, isBST and "BST" or "GMT")
end

