local function moveTo(position)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not farmEnabled or not getgenv().WietHubScriptRunning then
        return false
    end

    local distance = (root.Position - position).Magnitude
    if distance < 0.1 then
        return true
    end

    if activeTween then
        pcall(function() activeTween:Cancel() end)
    end

    activeTween = TweenService:Create(
        root,
        TweenInfo.new(distance / 24, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(position) }
    )
    activeTween:Play()

    repeat
        task.wait()
    until activeTween.PlaybackState ~= Enum.PlaybackState.Playing
        or not farmEnabled
        or not getgenv().WietHubScriptRunning

    local completed = farmEnabled
        and getgenv().WietHubScriptRunning
        and activeTween.PlaybackState == Enum.PlaybackState.Completed

    if not completed and activeTween then
        pcall(function() activeTween:Cancel() end)
    end
    activeTween = nil
    return completed
end

local function findClosestItem()
    local spawns = workspace:FindFirstChild("SpawnsLoot")
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not spawns or not root then
        return nil, nil
    end

    local closestItem, closestModel
    local closestDistance = math.huge

    for _, spawnModel in ipairs(spawns:GetChildren()) do
        if spawnModel.Name == "SpawnForLoot" then
            for _, object in ipairs(spawnModel:GetDescendants()) do
                if object:IsA("BasePart")
                    and (selectedItem == "All" or object.Name == selectedItem)
                    and object.Transparency == 0 then
                    local targetPosition = Vector3.new(object.Position.X, farmY, object.Position.Z)
                    local distance = (root.Position - targetPosition).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closestItem = object
                        closestModel = spawnModel
                    end
                end
            end
        end
    end

    return closestItem, closestModel
end

local function farmLoop()
    task.spawn(function()
        while farmEnabled and getgenv().WietHubScriptRunning do
            local item, spawnModel = findClosestItem()

            if item and item.Parent and spawnModel then
                local itemPosition = item.Position
                local groundPosition = Vector3.new(itemPosition.X, farmY, itemPosition.Z)

                if moveTo(groundPosition) and moveTo(itemPosition) then
                    local part = spawnModel:FindFirstChild("Part", true)
                    local attachment = part and part:FindFirstChildWhichIsA("Attachment")
                    local prompt = attachment and attachment:FindFirstChildWhichIsA("ProximityPrompt")

                    if prompt and prompt.Parent then
                        pcall(function()
                            prompt.MaxActivationDistance = 12
                            prompt.RequiresLineOfSight = false
                            fireproximityprompt(prompt)
                        end)
                    end

                    task.wait(0.15)
                    moveTo(groundPosition)
                end
            else
                moveTo(waitPosition)
                task.wait(1)
            end

            task.wait(0.05)
        end
    end)
end

