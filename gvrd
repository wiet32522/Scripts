local function findBreakableGlassModels()
    local jewelryStore = workspace:FindFirstChild("JewelryStore", true)

    if not jewelryStore then
        return {}, "JewelryStore not found under workspace yet"
    end

    local rayIgnore = jewelryStore:FindFirstChild("RayIgnore", true)

    if not rayIgnore then
        return {}, "RayIgnore not found inside JewelryStore yet"
    end

    local models = {}
    local seen = {}
    local jewelryStandCount = 0

    for _, object in ipairs(rayIgnore:GetDescendants()) do
        if object.Name == "JewelryStand" and (object:IsA("Model") or object:IsA("Folder")) then
            jewelryStandCount += 1

            for _, child in ipairs(object:GetDescendants()) do
                if child.Name == "BreakableGlass"
                    and (child:IsA("Model") or child:IsA("Folder"))
                    and not seen[child] then
                    seen[child] = true
                    table.insert(models, child)
                end
            end
        end
    end

    return models, "Found " .. jewelryStandCount .. " JewelryStand objects and " .. #models .. " BreakableGlass models"
end

