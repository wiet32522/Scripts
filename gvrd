    repeat
        bankModel = workspace:FindFirstChild("BANK")

        if bankModel then
            local buttonPanel = bankModel:FindFirstChild("ButtonPanel", true)
            local promptPart = buttonPanel
                and buttonPanel:FindFirstChild("PromptPart", true)
